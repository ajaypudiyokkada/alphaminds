# ── Django ────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Public hostname(s) of the site, comma-separated (no scheme)
ALLOWED_HOSTS=example.com,www.example.com
# Full origins incl. scheme; required for login/admin forms over HTTPS
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Cookies are Secure + X-Forwarded-Proto is trusted whenever DEBUG=False.
# Only set False to test a DEBUG=False build over plain http (never on the server).
# SECURE_COOKIES=True
# nginx already redirects http -> https, so leave this off unless you want Django to as well.
# SECURE_SSL_REDIRECT=False

# ── Database ──────────────────────────────────────────────────────────────────
# Server / Docker: PostgreSQL. docker-compose forces DB_ENGINE=postgresql and DB_HOST=db
# for the backend container, so only the three values below matter on the server.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=alphaminds
DB_USER=alphaminds
DB_PASSWORD=generate-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Local development with MySQL instead (default engine when DB_ENGINE is unset):
# DB_ENGINE=django.db.backends.mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ── CORS (mobile app / web clients) ───────────────────────────────────────────
# Comma-separated origins. Native Expo apps do not send an Origin, so this can stay empty.
CORS_ALLOWED_ORIGINS=https://example.com
# Dev only: True allows every origin. Must be False in production.
CORS_ALLOW_ALL_ORIGINS=False

# ── JWT lifetimes ─────────────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7
