# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). DB_HOST=localhost when running outside Docker;
# docker-compose overrides it to "db" for the backend container.
# For the MySQL fallback use DB_ENGINE=django.db.backends.mysql and DB_PORT=3306.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=alphaminds
DB_USER=alphaminds
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Dev only: set True to allow every origin
CORS_ALLOW_ALL_ORIGINS=False

# JWT lifetimes
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7